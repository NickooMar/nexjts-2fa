# Application
PORT=
NODE_ENV=

# Auth
AUTH_SERVICE_HOST=
AUTH_SERVICE_PORT=

# User
USER_SERVICE_HOST=
USER_SERVICE_PORT=

# Email
EMAIL_SERVICE_HOST=
EMAIL_SERVICE_PORT=

# Billing
BILLING_SERVICE_HOST=
BILLING_SERVICE_PORT=

# JWT
JWT_SECRET=
JWT_SECRET_EXPIRES_IN=

# Frontend
FRONTEND_URL=

# Database - Mongo
MONGO_URI=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Object storage (property media, org branding) ----------------------
# Local dev (docker-compose MinIO — these are also the defaults, so you can
# omit everything and it just works):
#   STORAGE_PROVIDER=minio
#   STORAGE_ENDPOINT=http://minio:9000          # service-reachable (Docker DNS)
#   STORAGE_PUBLIC_ENDPOINT=http://localhost:9000  # browser-reachable
#   STORAGE_ACCESS_KEY_ID=minioadmin
#   STORAGE_SECRET_ACCESS_KEY=minioadmin
#
# Production (AWS S3):
#   STORAGE_PROVIDER=s3
#   STORAGE_REGION=us-east-1
#   STORAGE_BUCKET=my-prod-media-bucket
#   # Leave the keys empty to use the task/instance IAM role:
#   STORAGE_ACCESS_KEY_ID=
#   STORAGE_SECRET_ACCESS_KEY=
STORAGE_PROVIDER=minio
STORAGE_BUCKET=property-manager-media
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=admin
STORAGE_SECRET_ACCESS_KEY=admin123
STORAGE_ENDPOINT=http://localhost:9000
#STORAGE_PUBLIC_ENDPOINT=http://localhost:9000

# How clients receive file URLs:
#   signed  → time-limited presigned GET URLs (private bucket; production)
#   public  → plain <endpoint>/<bucket>/<key> URLs (public-read bucket; dev)
STORAGE_URL_MODE=signed
STORAGE_SIGNED_URL_TTL_SECONDS=900

# --- Security / rate limiting (gateway) ---------------------------------
# Centralized store for rate limits, lockouts and suspicion scores.
# Required for multi-replica deployments; without it limits are per-process.
REDIS_URL=redis://localhost:6379

# Proxy hops in front of the gateway (ALB=1, nginx+ALB=2). Controls how
# X-Forwarded-For is resolved into the real client IP.
TRUST_PROXY=1

# Master switches
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_OPEN=true

# Global ceilings (all optional — defaults shown)
#RATE_LIMIT_IP_LIMIT=300
#RATE_LIMIT_IP_TTL_SECONDS=60
#RATE_LIMIT_IDENTITY_LIMIT=120
#RATE_LIMIT_IDENTITY_TTL_SECONDS=60

# Per-endpoint policies: RATE_LIMIT_<POLICY>_{LIMIT,TTL_SECONDS,BLOCK_SECONDS}
# Policies: SIGNIN, SIGNUP, CHECK_EMAIL, REFRESH, VERIFY_EMAIL,
#           CREATE_ORG, INVITATION, JOIN_ORG, SWITCH_ORG
#RATE_LIMIT_SIGNIN_LIMIT=5
#RATE_LIMIT_SIGNIN_TTL_SECONDS=60
#RATE_LIMIT_SIGNIN_BLOCK_SECONDS=300

# Brute-force lockouts: LOCKOUT_<SCOPE>_{MAX_ATTEMPTS,WINDOW_SECONDS,BASE_LOCK_SECONDS,MAX_LOCK_SECONDS}
# Scopes: LOGIN_ACCOUNT, LOGIN_IP, VERIFY_EMAIL, INVITE_JOIN
#LOCKOUT_LOGIN_ACCOUNT_MAX_ATTEMPTS=5
#LOCKOUT_LOGIN_ACCOUNT_BASE_LOCK_SECONDS=300

# Bot detection & optional CAPTCHA
BOT_DETECTION_ENABLED=true
#BOT_FLAG_THRESHOLD=10
CAPTCHA_ENABLED=false
#CAPTCHA_MODE=flagged            # flagged | always
#CAPTCHA_PROVIDER=turnstile      # turnstile | recaptcha
#CAPTCHA_SECRET=

# --- Billing / subscriptions --------------------------------------------
# Active payment provider (mock | stripe | mercadopago). The mock provider
# settles charges synchronously so the full lifecycle works without
# credentials; real providers plug in as PaymentProvider implementations.
BILLING_PAYMENT_PROVIDER=mock
# HMAC secret verifying mock-provider webhooks (x-billing-signature header).
BILLING_WEBHOOK_SECRET=dev-billing-webhook-secret
# Plan (slug) new organizations are subscribed to automatically.
BILLING_DEFAULT_PLAN=free
# Pass limit checks when the billing service is down (true) or reject with
# 503 (false). Mirrors RATE_LIMIT_FAIL_OPEN.
BILLING_ENFORCEMENT_FAIL_OPEN=true
# Days a past_due subscription keeps service before being suspended.
BILLING_PAST_DUE_GRACE_DAYS=7
